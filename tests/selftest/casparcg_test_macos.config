<?xml version="1.0" encoding="utf-8"?>
<!--
    CasparCG Test Configuration for macOS

    This configuration is designed for running self-tests on macOS.
    Since screen consumer is disabled on macOS (Phase 9), we use
    system-audio only for feedback.

    Copy this to your CasparCG directory as casparcg.config before running tests.

    Channel 1: Main playback channel
    Channel 2: Secondary channel for routing tests
-->
<configuration>
    <paths>
        <media-path>media/</media-path>
        <log-path>log/</log-path>
        <data-path>data/</data-path>
        <template-path>template/</template-path>
    </paths>

    <lock-clear-phrase>secret</lock-clear-phrase>

    <channels>
        <!-- Channel 1: Main playback (no screen output on macOS yet) -->
        <channel>
            <video-mode>720p5000</video-mode>
            <consumers>
                <system-audio />
            </consumers>
        </channel>

        <!-- Channel 2: Secondary channel (can route from ch1) -->
        <channel>
            <video-mode>720p5000</video-mode>
            <consumers>
            </consumers>
        </channel>
    </channels>

    <controllers>
        <tcp>
            <port>5260</port>
            <protocol>AMCP</protocol>
        </tcp>
    </controllers>

    <osc>
        <default-port>6250</default-port>
        <disable-send-to-amcp-clients>false</disable-send-to-amcp-clients>
        <predefined-clients />
    </osc>
</configuration>
